%%%-------------------------------------------------------------------
%%% 実行プラン。
%%%
%%% sql_analyzer が AST とカタログを突き合わせて組み立てる。
%%% この時点でカラム名は消えており、式は行タプル内の**位置**を指す。
%%% 実行時に名前で引くことがないので、評価は element/2 だけで済む。
%%%-------------------------------------------------------------------

%% テーブルを丸ごと走査する。
%% schema はこの演算子が出す行のカラム名(順序つき)。上位の解決に使う。
-record(p_seq_scan, {
    table,
    schema = []
}).

%% 述語を満たす行だけを通す(σ)。
-record(p_filter, {
    pred,
    input
}).

%% 式を評価して出力行を組み立てる(π)。
%% names は結果のカラム名。
-record(p_project, {
    exprs = [],
    names = [],
    input
}).
