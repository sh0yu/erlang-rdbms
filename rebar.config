{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_untyped_record
]}.

{deps, []}.

{eunit_opts, [verbose]}.
{eunit_tests, [{dir, "test"}]}.
{cover_enabled, true}.

{dialyzer, [{warnings, [unknown, unmatched_returns, error_handling]}]}.

{shell, [{apps, [tether]}]}.
