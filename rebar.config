{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_untyped_record
]}.

{deps, []}.

{eunit_opts, [verbose]}.

%% 試験モジュールを明示する。{dir, "test"} や既定の探索だと、
%% 試験を持たないモジュールまで対象に入り、「中止」として
%% 非ゼロ終了になる。増やしたらここに足すこと。
{eunit_tests, [{module, tether_rec_tests},
               {module, tether_log_tests},
               {module, tether_data_tests},
               {module, tether_store_tests},
               {module, tether_session_tests},
               {module, tether_checkpoint_tests},
               {module, tether_escrow_tests},
               {module, tether_offline_tests},
               {module, tether_sync_tests},
               {module, tether_isolation_tests},
               {module, tether_test_util}]}.
{cover_enabled, true}.

{dialyzer, [{warnings, [unknown, unmatched_returns, error_handling]}]}.

{shell, [{apps, [tether]}]}.
