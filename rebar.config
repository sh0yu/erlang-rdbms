{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    {i, "include"}
]}.

{deps, []}.

{eunit_opts, [verbose]}.

%% テストモジュールを明示する。指定しないとアプリケーション経由と
%% モジュール直接指定の両方で拾われ、同じテストが2度走る。
{eunit_tests, [{dir, "test"}]}.

{cover_enabled, true}.

{dialyzer, [
    {warnings, [unknown]}
]}.

{shell, [{apps, [transaction_db]}]}.
