#!/bin/sh
# transaction_db のブラウザ用SQLクライアント。
#
#   bin/sqlweb           http://127.0.0.1:8080 で待ち受ける
#   bin/sqlweb 9000      ポートを指定する
#
# 停止は Ctrl+C を2回。データは ./data に置かれる。
set -e
cd "$(dirname "$0")/.."

# Erlang は /usr/bin/erl にある想定。rebar3 は apt に無いので
# ~/.local/bin に置いてあることがある。
if [ -x "$HOME/.local/bin/rebar3" ]; then PATH="$HOME/.local/bin:$PATH"; fi
export PATH

if ! command -v erl >/dev/null 2>&1; then
    echo "erl が見つかりません。Erlang/OTP 25 以降を入れてください:" >&2
    echo "  sudo apt install erlang-nox erlang-dev erlang-parsetools erlang-dialyzer" >&2
    exit 1
fi

EBIN=_build/default/lib/transaction_db/ebin
if [ ! -f "$EBIN/web_ui.beam" ]; then
    echo "building..." >&2
    rebar3 compile >/dev/null
fi

PORT="${1:-8080}"
# 起動に失敗したら待たずに落ちる。失敗しても receive で待つと
# 「起動したのに繋がらない」という分かりにくい状態になる。
exec erl -noshell +pc unicode -pa "$EBIN" -eval "
    case web_ui:start($PORT) of
        {ok, _} -> receive stop -> ok end;
        _ -> halt(1)
    end."
