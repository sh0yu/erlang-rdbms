#!/bin/sh
# transaction_db の対話SQLシェル。
#
#   bin/sqlsh              対話シェルを開く
#   bin/sqlsh --tour       同梱のツアー(priv/tour.sql)を流す
#   bin/sqlsh FILE.sql     ファイルの文を順に実行する
#
# データは ./data に置かれる。消したいときは rm -rf data。
set -e
cd "$(dirname "$0")/.."

# Erlangを探す。PATHに無ければ、よくある置き場所を見に行く。
# このマシンにはシステムのErlangが無く、~/.local/erlang に置いてあるため。
if ! command -v erl >/dev/null 2>&1; then
    for d in "$HOME/.local/erlang/bin" /usr/local/lib/erlang/bin /usr/lib/erlang/bin; do
        if [ -x "$d/erl" ]; then
            PATH="$d:$PATH"
            break
        fi
    done
fi
if [ -x "$HOME/.local/bin/rebar3" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi
export PATH

if ! command -v erl >/dev/null 2>&1; then
    echo "erl が見つかりません。Erlang/OTP 25 以降を入れるか、" >&2
    echo "PATH に erl を通してから実行してください。" >&2
    exit 1
fi

EBIN=_build/default/lib/transaction_db/ebin

if [ ! -d "$EBIN" ] || [ ! -f "$EBIN/sql_shell.beam" ]; then
    if ! command -v rebar3 >/dev/null 2>&1; then
        echo "rebar3 が見つかりません。make でもビルドできます。" >&2
        exit 1
    fi
    echo "building..." >&2
    rebar3 compile >/dev/null
fi

case "$1" in
    --tour) EXPR='sql_shell:run_file("priv/tour.sql"), halt().' ;;
    "")     EXPR='sql_shell:start(), halt().' ;;
    *)      EXPR="sql_shell:run_file(\"$1\"), halt()." ;;
esac

exec erl -noshell +pc unicode -pa "$EBIN" -eval "$EXPR"
